# ECOING - Inspección Ligera · configuración del entorno
#
# Copiar a `.env` y ajustar. Este archivo documenta TODAS las variables que
# entiende `api/config/app.php`; los valores de aquí son los de un XAMPP local.
#
# Para la pila Docker del QNAP NO se usa este archivo: las variables se pasan a
# los contenedores desde `docker/.env` (ver `docker/.env.example`). El código es
# el mismo: `envValue()` lee primero el archivo .env y, si la clave no está,
# consulta el entorno del proceso con getenv().

APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/INSPEECIONLIGERAECOING
APP_TIMEZONE=America/Lima
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Ruta alternativa del propio archivo .env. Sirve para dejarlo FUERA del
# DocumentRoot (por ejemplo `/config/.env` montado como solo-lectura) en vez de
# pasar las credenciales por variables de entorno. Se lee del entorno del
# proceso, no del .env. Vacío o ausente = se usa `<raíz del proyecto>/.env`.
# APP_ENV_FILE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecoing_inspeccion
DB_USERNAME=root
DB_PASSWORD=

# Genere un valor aleatorio de al menos 32 caracteres para cada instalación.
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-de-32-caracteres
JWT_TTL=31536000

# ---------------------------------------------------------------------------
# Almacenamiento
# ---------------------------------------------------------------------------
# `local` = rutas dentro del proyecto (XAMPP). `nas` = puntos de montaje del
# QNAP. Es informativo: el código escribe en las rutas de abajo en los dos
# casos.
STORAGE_DRIVER=local

# Todas son opcionales. Si se omiten, se usan los valores históricos relativos
# a la raíz del proyecto, de modo que una instalación XAMPP existente sigue
# funcionando sin tocar nada:
#
#   IMAGE_STORAGE_PATH   -> <proyecto>/storage/images
#   PDF_STORAGE_PATH     -> <proyecto>/storage/pdf
#   BACKUP_STORAGE_PATH  -> <proyecto>/storage/backups
#   LOG_STORAGE_PATH     -> <proyecto>/storage/logs
#   EXPORT_STORAGE_PATH  -> <proyecto>/storage/exports
#
# En la base de datos SIEMPRE se guarda la ruta RELATIVA a IMAGE_STORAGE_PATH
# (`proyecto_1/linea_L-6021/poste_452/placa_ab12.jpg`), nunca la absoluta. Así
# mover el almacén de sitio no obliga a reescribir ninguna fila.
# IMAGE_STORAGE_PATH=
# PDF_STORAGE_PATH=
# BACKUP_STORAGE_PATH=
# Raíz de solo lectura donde Qfile/Qsync deja la carpeta
# 'Inspeccion Ligera 2026'. Puede contener un nivel previo por dispositivo.
# Si se omite: <proyecto>/storage/backups/moviles
# Respaldo de las inspecciones. En el NAS es su propio share, montado en el
# contenedor como /data/elpu, con el árbol
#   <raiz>/<lo que organice el share>/Linea_<linea>/Estructura_<estructura>/
#       Formulario/formulario.json
#       Fotos/01_Panoramica.jpg ...
# Se lee en SOLO LECTURA: la aplicación nunca escribe aquí.
# MOBILE_BACKUP_ROOT=/data/elpu
# Nombre anterior, se sigue aceptando:
# MOBILE_BACKUP_STORAGE_PATH=
# ADMIN_ARCHIVE_STORAGE_PATH=
# Segundos mínimos desde la última modificación para no leer una copia parcial.
MOBILE_BACKUP_STABILITY_SECONDS=10
# LOG_STORAGE_PATH=
# EXPORT_STORAGE_PATH=

# ---------------------------------------------------------------------------
# Procesamiento de imágenes
# ---------------------------------------------------------------------------
# Lado mayor máximo de la fotografía almacenada.
IMAGE_MAX_DIMENSION=2400

# `auto`   = no recodificar lo que ya llega bien desde el teléfono (JPEG válido,
#            dentro de IMAGE_MAX_DIMENSION, por debajo de
#            IMAGE_REENCODE_MAX_BYTES y con orientación EXIF normal).
# `always` = reprocesar siempre con GD (comportamiento anterior).
IMAGE_REENCODE_MODE=auto
IMAGE_REENCODE_MAX_BYTES=4194304
IMAGE_JPEG_QUALITY=85

# ---------------------------------------------------------------------------
# Reportes y diagnóstico
# ---------------------------------------------------------------------------
# Reutilizar el PDF ya generado mientras no cambie el formulario ni las fotos.
PDF_CACHE_ENABLED=true

# Registrar tiempos de subida en <LOG_STORAGE_PATH>/rendimiento.log.
UPLOAD_METRICS_ENABLED=false

# Datos visibles en las firmas del reporte PDF (opcionales).
# Firmantes del reporte PDF. Si se dejan vacíos se usan los valores por
# defecto del código: Supervisor de obra = EDUARDO PANCORBO SALAS.
# PDF_SUPERVISOR_OBRA_NOMBRE=
# PDF_SUPERVISOR_OBRA_CARGO=
# PDF_SUPERVISOR_CONTRATISTA_NOMBRE=
# PDF_SUPERVISOR_CONTRATISTA_CARGO=
# Variables antiguas, que ningún archivo lee (se conservan por historia):
SUPERVISOR_CLIENTE_NOMBRE=
SUPERVISOR_CLIENTE_CIP=
SUPERVISOR_CONTRATISTA_NOMBRE=
SUPERVISOR_CONTRATISTA_CIP=
