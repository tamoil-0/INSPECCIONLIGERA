# Configuración por entorno — NO hay secretos aquí.
#
# La app NO lee este archivo: los valores se pasan con --dart-define al
# compilar. Este archivo solo documenta las claves disponibles.
#
# Motivo: un .env empaquetado dentro del APK no es un secreto — se extrae con
# `unzip`. Con --dart-define los valores se compilan dentro del binario y no hay
# archivo de activos que alguien pueda leer.

# --- API ---
# URL base, sin barra final.
API_BASE_URL=https://grupoecoing.com/inspeccionligera/api

# Nombre del entorno: produccion | pruebas | local
# Cuando NO es "produccion" se muestra una etiqueta en el login.
ENTORNO=produccion

# --- Tiempos de espera ---
TIMEOUT_SEGUNDOS=30
TIMEOUT_SUBIDA_MINUTOS=4

# --- Diagnóstico ---
# Registro detallado en consola. Dejar en false para producción.
REGISTRO_DETALLADO=false

# --- Contrato del formulario ---
# Enviar literalmente "no_revisado" en los campos que el inspector no confirmó.
# Ver BACKEND_CONTRATO.md antes de activarlo: es un cambio de contrato en 19
# campos y el backend tiene que aceptarlo.
ENVIAR_NO_REVISADO=false


# ============================================================================
# Ejemplos de uso
# ============================================================================
#
# Producción (todos los valores por defecto):
#   flutter build apk --release
#
# Producción con APK por arquitectura (17-19 MB en lugar de 52 MB):
#   flutter build apk --release -PsplitApks=true
#
# Para Google Play:
#   flutter build appbundle --release
#
# Preproducción:
#   flutter build apk --release \
#     --dart-define=API_BASE_URL=https://pruebas.grupoecoing.com/inspeccionligera/api \
#     --dart-define=ENTORNO=pruebas
#
# Servidor local durante el desarrollo (HTTP permitido solo en debug):
#   flutter run \
#     --dart-define=API_BASE_URL=http://192.168.0.101/api \
#     --dart-define=ENTORNO=local \
#     --dart-define=REGISTRO_DETALLADO=true
#
# Con el contrato nuevo del formulario, cuando el backend esté listo:
#   flutter build apk --release --dart-define=ENVIAR_NO_REVISADO=true
