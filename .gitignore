/.env
/.idea/
/.vscode/
/.composer-cache/

# Configuración de los contenedores: contiene contraseñas de MariaDB y el
# JWT_SECRET del NAS. La plantilla versionada es docker/.env.example.
/docker/.env
/docker/.env.*
!/docker/.env.example

# Dependencias instalables
/api/vendor/
/api/librerias/*
!/api/librerias/.htaccess
*.zip

# Archivos generados o sensibles
/data/
/api/descargas/*
!/api/descargas/.htaccess
/api/estado_exportaciones/*
!/api/estado_exportaciones/.htaccess
/api/exportes/*
!/api/exportes/.htaccess
/storage/images/*
!/storage/images/.gitkeep
/storage/exports/*
!/storage/exports/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
# Creadas al vuelo por api/config/storage.php cuando no se configuran las
# variables *_STORAGE_PATH (instalación XAMPP). En el NAS su contenido vive en
# /share/.../InspeccionLigera y nunca pasa por el repositorio.
/storage/pdf/
/storage/backups/
*.log
error_log
headers_log.txt
errores_*.txt
log_*.txt

# Dumps con datos: el esquema limpio vive en database/schema.sql
/database/ecoing_inspeccion_con_estructuras.sql
/database/*_servidor.sql
/*inventario*.sql
/api/*.sql

# Aplicaciones heredadas que no pertenecen al sistema ECOING
/build/*
!/build/.htaccess
/controllers/*
!/controllers/.htaccess
/views/*
!/views/.htaccess

# Paquetes de despliegue al NAS (se regeneran; no son código)
*.tgz
*.tar.gz
*.tar.gz.sha256
/release_*/
/despliegue_plantillas/*.tar.gz

# Dumps con datos reales: el repositorio es público
/database/backups/
/migracion/

# Firmas escaneadas: datos personales, no van a un repositorio público
/api/clases/images/FIRMA.jpg
/api/clases/images/firma.png

# App móvil: vive en la rama app-movil
/pruebaoffline/

# Revisión visual y material de referencia de diseño
/.ui-review/
/.referencias/
