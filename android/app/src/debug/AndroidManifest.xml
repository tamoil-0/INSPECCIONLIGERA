<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Solo en compilaciones de depuración.

      · INTERNET: lo necesita el Dart VM Service para el hot reload.
      · usesCleartextTraffic: permite apuntar a un servidor local por HTTP
        durante el desarrollo (--dart-define=API_BASE_URL=http://192.168.x.x/api).
        En release NO se permite tráfico sin cifrar.
      · allowBackup: se deja como en release para probar el mismo comportamiento.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
