# ECOING - Inspección Ligera · variables de los contenedores
# ===========================================================
#
# Copiar a `docker/.env` y editar. Ese archivo está en .gitignore: NUNCA se
# suben contraseñas reales al repositorio.
#
#   cp docker/.env.example docker/.env
#
# Este archivo es distinto del `.env` de la raíz, que sigue perteneciendo al
# entorno XAMPP y no se toca. Los contenedores no leen ningún `.env` del
# proyecto: reciben estas variables por `env_file` en docker-compose.yml y
# `api/config/app.php` las lee con getenv().

# ===========================================================================
# Aplicación
# ===========================================================================
APP_ENV=production
APP_DEBUG=false

# IP del NAS en la LAN de la oficina y puerto publicado por Compose.
# Se usa para el `iss`/`aud` del JWT, así que si cambia, las sesiones abiertas
# dejan de validar y hay que volver a iniciar sesión (no se pierde ningún dato).
# El código NUNCA lleva esta IP escrita: solo vive aquí.
APP_URL=http://192.168.1.3:8082

APP_TIMEZONE=America/Lima

# La web administrativa se sirve desde el mismo origen que el API, así que no
# necesita CORS. Esta lista solo hace falta si algún día se abre la web desde
# otro host. Separar con comas, sin barra final.
CORS_ALLOWED_ORIGINS=http://192.168.1.3:8082

# ===========================================================================
# Base de datos
# ===========================================================================
# `ecoing-db` es el NOMBRE DEL SERVICIO de docker-compose.yml. Dentro de la red
# interna de Docker resuelve a la IP del contenedor de MariaDB.
# NO usar localhost/127.0.0.1: dentro de `ecoing-app` eso apunta al propio
# contenedor de Apache, donde no hay ninguna base de datos.
DB_HOST=ecoing-db
DB_PORT=3306
DB_DATABASE=ecoing_inspeccion
DB_USERNAME=ecoing_user
DB_PASSWORD=CHANGE_ME

# --- Las mismas credenciales, en el formato que espera la imagen de MariaDB.
# MARIADB_PASSWORD debe ser idéntica a DB_PASSWORD y MARIADB_DATABASE a
# DB_DATABASE, o la aplicación no podrá conectarse.
# Solo se aplican la PRIMERA vez que arranca el contenedor con el datadir
# vacío; después, cambiar la contraseña aquí no la cambia en la base.
MARIADB_DATABASE=ecoing_inspeccion
MARIADB_USER=ecoing_user
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME_TAMBIEN
MARIADB_AUTO_UPGRADE=1

# ===========================================================================
# JWT
# ===========================================================================
# Mínimo 32 caracteres (api/config/jwt.php lo verifica y aborta si no llega).
# Generar uno propio para esta instalación:
#   openssl rand -hex 32
# Cambiarlo invalida todas las sesiones activas de la web y de la app.
JWT_SECRET=CHANGE_ME_POR_64_CARACTERES_HEXADECIMALES_ALEATORIOS
JWT_TTL=31536000

# ===========================================================================
# Almacenamiento
# ===========================================================================
# `nas` documenta que las rutas de abajo son puntos de montaje del QNAP.
# `local` es el valor equivalente para XAMPP. El código trata a los dos igual:
# escribe en las rutas indicadas. La variable existe para que se vea de un
# vistazo dónde está corriendo el sistema.
STORAGE_DRIVER=nas

# Rutas INTERNAS del contenedor. docker-compose.yml las vuelve a declarar, así
# que no hay que tocarlas aquí; la ruta real del NAS se decide en los `volumes`
# de ese archivo. El PHP nunca ve `/share/CACHEDEV1_DATA/...` ni `C:\xampp82`.
IMAGE_STORAGE_PATH=/data/imagenes
PDF_STORAGE_PATH=/data/pdf
BACKUP_STORAGE_PATH=/data/backups
MOBILE_BACKUP_STORAGE_PATH=/data/backups/moviles
MOBILE_BACKUP_STABILITY_SECONDS=10
# Archivo recuperable de limpiezas administrativas (ruta interna del contenedor).
# ADMIN_ARCHIVE_STORAGE_PATH=/data/backups/archivo_admin
LOG_STORAGE_PATH=/data/logs
EXPORT_STORAGE_PATH=/data/exports

# ===========================================================================
# Rendimiento del procesamiento de imágenes
# ===========================================================================
# Lado mayor máximo, en píxeles, de la fotografía guardada en el NAS.
IMAGE_MAX_DIMENSION=2400

# Qué hace PHP con una fotografía que llega ya optimizada desde el teléfono:
#
#   auto    Recomendado. Si es JPEG válido, cabe en IMAGE_MAX_DIMENSION, pesa
#           menos de IMAGE_REENCODE_MAX_BYTES y su orientación EXIF es normal,
#           se guarda tal cual: se ahorra el ciclo decodificar+redimensionar+
#           recodificar con GD, que en el ARM del NAS es lo que más tarda de
#           toda la subida. La validación de seguridad se aplica igual.
#   always  Comportamiento anterior: reprocesar siempre con GD.
IMAGE_REENCODE_MODE=auto
IMAGE_REENCODE_MAX_BYTES=4194304
IMAGE_JPEG_QUALITY=85

# Caché de PDF en PDF_STORAGE_PATH. Un PDF se reutiliza mientras no cambie el
# formulario ni ninguna de las fotografías del poste.
PDF_CACHE_ENABLED=true

# Registrar en /data/logs/rendimiento.log el tiempo de cada subida
# (recepción, validación, escritura en disco y actualización de la base).
UPLOAD_METRICS_ENABLED=true

# ===========================================================================
# Firmas del reporte PDF (opcionales)
# ===========================================================================
SUPERVISOR_CLIENTE_NOMBRE=
SUPERVISOR_CLIENTE_CIP=
SUPERVISOR_CONTRATISTA_NOMBRE=
SUPERVISOR_CONTRATISTA_CIP=
